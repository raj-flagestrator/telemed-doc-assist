# Build a single portal SPA (patient | doctor | pharmacy) via APP_NAME build-arg.
FROM node:22-alpine AS build
WORKDIR /src

ARG APP_NAME=patient-web
ARG VITE_API_BASE_URL=http://localhost:4100

COPY apps/${APP_NAME}/package.json apps/${APP_NAME}/package-lock.json ./
RUN npm ci

COPY apps/${APP_NAME}/ ./
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
