# Copy to deploy/.env and adjust for your environment.
# Used by docker compose for all MediSphere prototype services.

POSTGRES_USER=medisphere
POSTGRES_PASSWORD=medisphere
POSTGRES_DB=medisphere

JWT_SECRET=prototype-dev-secret-change-in-production
DEFAULT_TENANT_ID=demo-maldives

# Host port mappings (browser + local tools)
POSTGRES_HOST_PORT=5434
PATIENT_BFF_HOST_PORT=4100
DOCTOR_BFF_HOST_PORT=4101
PHARMACY_BFF_HOST_PORT=4102
PATIENT_WEB_HOST_PORT=5173
DOCTOR_WEB_HOST_PORT=5174
PHARMACY_WEB_HOST_PORT=5175

# Public API URLs baked into frontends at build time (host machine perspective)
PATIENT_WEB_API_URL=http://localhost:4100
DOCTOR_WEB_API_URL=http://localhost:4101
PHARMACY_WEB_API_URL=http://localhost:4102
